{
  "name": "picx-mcp",
  "version": "0.1.0",
  "description": "PicX Studio MCP server - image and video generation tools for any MCP client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "picx-mcp": "bin/picx-mcp.js"
  },
  "main": "./dist/server.js",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "picx",
    "image-generation",
    "video-generation"
  ],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "picx-ai": "0.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@picx/core": "workspace:*",
    "@picx/tools": "workspace:*"
  },
  "exports": {
    ".": {
      "import": "./dist/server.js"
    },
    "./stdio": {
      "import": "./dist/stdio.js"
    }
  }
}
